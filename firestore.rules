rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner() {
      return isSignedIn() && request.auth.uid == resource.data.contribuidorId;
    }
    
    // Países - lectura pública, escritura restringida
    match /paises/{paisId} {
      allow read: if true;
      allow write: if false; // Solo ingesta admin
      
      // Regiones - lectura pública, escritura restringida
      match /regiones/{regionId} {
        allow read: if true;
        allow write: if false;
        
        // Platillos - lectura pública, escritura restringida
        match /platillos/{platilloId} {
          allow read: if true;
          allow write: if false;
        }
      }
    }
    
    // Platillos raíz - públicos si están publicados; dueños y admins pueden operar el flujo de revisión
    match /platillos/{platilloId} {
      allow read: if resource.data.estado == 'publicado' || isOwner() || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.contribuidorId == request.auth.uid
        && request.resource.data.estado == 'pendiente';
      allow update: if isAdmin()
        || (isOwner()
          && request.resource.data.contribuidorId == resource.data.contribuidorId
          && request.resource.data.estado == 'pendiente');
      allow delete: if isAdmin() || isOwner();
    }

    // Ingredientes - lectura pública, escritura restringida
    match /ingredientes/{ingredienteId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Aportes pendientes - escritura para contribuidores autenticados
    match /aportes/{aporteId} {
      allow read: if resource.data.contribuidorId == request.auth.uid;
      allow create: if true;
      allow update, delete: if resource.data.contribuidorId == request.auth.uid;
    }

    // Perfiles de Usuario y Gamificación
    match /usuarios/{userId} {
      // Lectura permitida para usuarios autenticados (para mostrar rangos y avatares en el atlas)
      allow read: if true;
      // Creación y edición permitida para el propio usuario
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();

      // Historial de Puntos Antropológicos
      match /historialPuntos/{puntoId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Subcolecciones comunitarias en Platillos
    match /platillos/{platilloId}/validacionesRaices/{valId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.usuarioId == request.auth.uid || isAdmin());
    }

    match /platillos/{platilloId}/puentesCulinarios/{puenteId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.usuarioId == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.usuarioId == request.auth.uid || isAdmin());
    }

    match /platillos/{platilloId}/adaptacionesLocales/{adaptacionId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.usuarioId == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.usuarioId == request.auth.uid || isAdmin());
    }
  }
}

